{
  "name": "@tsyvinda/api",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "dev": "nodemon",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "email:dev": "email dev --dir src/emails --port 3001",
    "db:migration:generate": "TS_NODE_TRANSPILE_ONLY=true typeorm-ts-node-commonjs migration:generate -d src/db/database.ts",
    "db:migration:run": "TS_NODE_TRANSPILE_ONLY=true typeorm-ts-node-commonjs migration:run -d src/db/database.ts",
    "db:migration:revert": "TS_NODE_TRANSPILE_ONLY=true typeorm-ts-node-commonjs migration:revert -d src/db/database.ts",
    "db:migration:run:prod": "typeorm migration:run -d dist/db/database.js",
    "db:migration:revert:prod": "typeorm migration:revert -d dist/db/database.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@react-email/render": "^2.1.1",
    "@tsyvinda/shared-types": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@react-email/ui": "^6.11.3",
    "@swc/core": "^1.16.20",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "private": true,
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json",
    "exec": "ts-node --transpile-only src/index.ts",
    "legacyWatch": true,
    "delay": 500
  }
}
