# Docker
COMPOSE_PROJECT_NAME=api-tsyvinda-local
RESTART_POLICY=no

# Domain
BACKEND_HOST=api.tsyvinda.local

# App
NODE_ENV=development
PORT=3000
FRONTEND_HOST=https://tsyvinda.com

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# S3
S3_BUCKET=tsyvinda-local
S3_REGION=eu-central-1
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_PUBLIC_URL=https://api.tsyvinda.local/s3
S3_FORCE_PATH_STYLE=true

# Redis
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-32+char-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
BCRYPT_COST=12
# SMTP. Compose sets SMTP_HOST=mailpit internally; these apply when running the
# backend natively (pnpm dev). Prod SMTP is configured in the infra repo, not here.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="Blog <noreply@example.com>"
COOKIE_DOMAIN=.yourdomain.com

# Security
TURNSTILE_SECRET_KEY=0x00000000000000000
# Optional: long random secret. Sending this exact value as cf-turnstile-response
# skips Cloudflare verification — lets you call captcha-protected routes from
# Swagger /docs on production without a widget. Leave unset to disable. Rotate to revoke.
TURNSTILE_BYPASS_TOKEN=1x00000000000000000

# Admin panel
# Host of the admin SPA; its https origin is added to CORS and allowed to write to /admin/*.
ADMIN_HOST=admin.tsyvinda.local
# Default admin, created on boot if missing (password never overwritten). Both or neither; 12+ chars.
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=change-me-to-12+chars
# Baked into the admin bundle at build time — Vite exposes only ADMIN_PUBLIC_* to the browser.
ADMIN_PUBLIC_API_URL=https://api.tsyvinda.local/admin
ADMIN_PORT=5173
