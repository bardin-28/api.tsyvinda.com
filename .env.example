# Docker
COMPOSE_PROJECT_NAME=api-tsyvinda-local
RESTART_POLICY=no

# Domain
BACKEND_HOST=api.tsyvinda.local
LETSENCRYPT_EMAIL=your@email.com

# App
NODE_ENV=development
PORT=3000
FRONTEND_HOST=https://tsyvinda.com

# Basic Auth (nginx-proxy, prod only)
BASIC_AUTH=false
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=password

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Redis
REDIS_URL=redis://localhost:6379


JWT_ACCESS_SECRET=replace-with-32+char-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
BCRYPT_COST=12
RESEND_API_KEY=test
EMAIL_FROM="Blog <noreply@example.com>"
COOKIE_DOMAIN=.yourdomain.com

# Security
TURNSTILE_SECRET_KEY=0x00000000000000000
