{
  "name": "tsyvinda-be",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@tsyvinda/api",
    "dev:admin": "turbo run dev --filter=@tsyvinda/admin",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "email:dev": "pnpm --filter @tsyvinda/api run email:dev",
    "db:migration:generate": "pnpm --filter @tsyvinda/api run db:migration:generate",
    "db:migration:run": "pnpm --filter @tsyvinda/api run db:migration:run",
    "db:migration:revert": "pnpm --filter @tsyvinda/api run db:migration:revert",
    "cert": "bash scripts/certs.sh",
    "prepare": "husky"
  },
  "prettier": "@tsyvinda/prettier-config",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@tsyvinda/eslint-config": "workspace:*",
    "@tsyvinda/prettier-config": "workspace:*",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "turbo": "2.11.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.9.0"
}
