{
  "name": "test-be",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon",
    "start": "node dist/index.js",
    "cert": "mkdir -p nginx-certs && HOST=$(grep '^BACKEND_HOST' .env.local | cut -d= -f2) && mkcert -install && mkcert -key-file nginx-certs/$HOST.key -cert-file nginx-certs/$HOST.crt $HOST localhost 127.0.0.1 ::1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "nodemon": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  },
  "private": true,
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json",
    "exec": "tsx src/index.ts",
    "legacyWatch": true,
    "delay": 500
  }
}
